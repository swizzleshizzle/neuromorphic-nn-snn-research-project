*.egg
MANIFEST

# --- Virtual environments ---
.venv/
venv/
ENV/
env/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Project-specific ---
data/*
!data/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
runs/*
!runs/.gitkeep
!outputs/.gitkeep
experiments/*/outputs/
!experiments/*/outputs/.gitkeep
# Variant output dirs (e.g. outputs_instrumented/ from a re-run that must not overwrite
# the original records). Without this they are untracked-but-not-ignored, which is exactly
# what a stray `git add -A` sweeps into an unrelated commit.
experiments/*/outputs_*/
wandb/
*.pt
*.pth
results.csv
training_curves.png

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets ---
.env
.env.local
*.key
*.pem

